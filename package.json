{
  "name": "iread",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iRead: a calm, dyslexia-friendly reading PWA (portfolio demo)",
  "scripts": {
    "postinstall": "node scripts/copy-fonts.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@fontsource/opendyslexic": "^5.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
